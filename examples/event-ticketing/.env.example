# Copy this file to .env and fill in values from your own testnet deployment.
# See ../README.md for how to deploy a factory + queue contract on testnet.

# Contract ID of the deployed LineProof factory (starts with C...)
FACTORY_CONTRACT_ID=

# Contract ID of the deployed queue instance for this example (starts with C...)
QUEUE_CONTRACT_ID=

# Secret key of the account submitting transactions (starts with S...)
# Leave unset for read-only calls (e.g. getPosition, isEnrolled).
LINEPROOF_PRIVATE_KEY=

# Optional overrides — defaults point at Stellar testnet.
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
