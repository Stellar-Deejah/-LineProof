# LineProof Backend – environment variables
# Copy this file to .env and fill in real values before starting the server.

# Express server port (default: 4000)
PORT=4000

# Node environment: development | test | production
NODE_ENV=development

# Friendly network label used by legacy read adapters.
STELLAR_NETWORK=TESTNET

# Exact Stellar network passphrase used to sign and simulate Soroban transactions.
# Required when any contract ID is configured.
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Soroban RPC endpoint for the selected network.
# Used to read authoritative on-chain state when contract IDs are configured
# (see ContractAdapter). Reads require a Soroban RPC (not Horizon) endpoint.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Operator secret key used only for write operations. If omitted in configured
# mode, reads remain enabled and writes return HTTP 503; never commit a real key.
OPERATOR_SECRET_KEY=

# ---------------------------------------------------------------------------
# Persistence (issue #4)
# ---------------------------------------------------------------------------
# PostgreSQL connection string. Leave EMPTY to use the in-memory adapter
# (default: state is ephemeral and wiped on restart — fine for local/dev/tests).
# Set it to select the durable PostgresAdapter. Apply the migrations in
# backend/src/db/migrations/ before enabling this.
#   e.g. postgres://user:password@localhost:5432/lineproof
DATABASE_URL=

# ---------------------------------------------------------------------------
# Deployed contract addresses — populate after running `make deploy-localnet`,
# or from a testnet deployment (see below).
# Leave every ID empty for mock mode. Once any ID is set, the enrollment,
# escrow, and queue-factory IDs plus RPC URL and network passphrase are required.
# GET routes prefer chain state and fall back with X-Data-Source: mock.
# Canonical names (issue #4); the LINEPROOF_-prefixed aliases below still work.
#
# For testnet, these map to keys in the deployment-summary.json artifact
# produced by .github/workflows/deploy-testnet.yml (also committed to
# deployments/testnet-latest.json — see deployments/README.md):
#   contracts["lineproof-queue-factory"].contractId -> QUEUE_FACTORY_CONTRACT_ID
#   contracts["lineproof-queue"].contractId          -> QUEUE_CONTRACT_ID
#   contracts["lineproof-enrollment"].contractId     -> ENROLLMENT_CONTRACT_ID
#   contracts["lineproof-identity"].contractId       -> IDENTITY_CONTRACT_ID
#   contracts["lineproof-escrow"].contractId         -> ESCROW_CONTRACT_ID
# The manifest's `.networkPassphrase` maps to NETWORK_PASSPHRASE above.
# Each contract entry also carries its own `envVar` field naming the target
# variable directly, so a CD pipeline can populate this file without a
# hardcoded mapping — see the loop in deployments/README.md.
# ---------------------------------------------------------------------------
QUEUE_FACTORY_CONTRACT_ID=
QUEUE_CONTRACT_ID=
ENROLLMENT_CONTRACT_ID=
IDENTITY_CONTRACT_ID=
ESCROW_CONTRACT_ID=

# Legacy aliases (kept for backward compatibility; canonical names take precedence)
LINEPROOF_FACTORY_CONTRACT_ID=
LINEPROOF_QUEUE_CONTRACT_ID=
LINEPROOF_ENROLLMENT_CONTRACT_ID=
LINEPROOF_IDENTITY_CONTRACT_ID=
LINEPROOF_ESCROW_CONTRACT_ID=

# CORS allowed origins (comma-separated exact http(s) origins).
# Wildcards and URL paths are rejected. Do not add trailing slashes.
# List every trusted production frontend explicitly, for example:
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Rate limiting and Payload limits (issue #108)
# ---------------------------------------------------------------------------
# Global maximum JSON payload size limit is hardcoded to 16kb.
# Per-route request limits, keyed by client IP. Each route group has its own
# independent counter, so a burst on one cannot exhaust another's quota.
# /health and /metrics are never rate-limited. See docs/rate-limiting.md.
#
# Shared window (milliseconds) for every limiter. Default: 60000 (1 minute).
RATE_LIMIT_WINDOW_MS=60000
# Read feeds (/public/*, /api/queues/*). Default: 600 per window.
READ_RATE_LIMIT_MAX=600
# Enrollment writes (/api/enrollments/*). Default: 10 per window.
ENROLLMENT_RATE_LIMIT_MAX=10
# Escrow writes (/api/escrow/*). Default: 10 per window.
ESCROW_RATE_LIMIT_MAX=10

# Log level: debug | info | warn | error
LOG_LEVEL=info
